# ════════════════════════════════════════════════════════════════
# Neko — Environment Configuration
# Copy this file to .env and fill in what you need. Only BOT_TOKEN
# and OWNER_ID are required — everything else has a working default
# or simply disables the feature it belongs to.
# ════════════════════════════════════════════════════════════════

# ── Core Bot (required) ────────────────────────────────────────
# BOT_TOKEN: from @BotFather
BOT_TOKEN=
# OWNER_ID: your numeric Telegram user ID (e.g. via @userinfobot)
OWNER_ID=
# ADMIN_IDS: comma-separated extra admin IDs, e.g. 111111,222222 — leave blank if none
ADMIN_IDS=
DEBUG=false
# Updates handled at once. Updates from one chat stay in order; different chats
# run in parallel so a slow download/LLM call in one chat can't stall the rest.
# 0 = legacy strictly-sequential processing.
CONCURRENT_UPDATES=64

# ── Identity / Branding ────────────────────────────────────────────
# User-facing display name/username/owner — shown in /start, /help,
# error messages, personality responses, collector messages, music
# messages, etc. See bot/identity.py.
BOT_DISPLAY_NAME=Neko
BOT_DISPLAY_USERNAME=Nekooooooobot
BOT_OWNER_NAME=Star

# ── Force-subscribe ──────────────────────────────────────────────
# Require joining a channel before using the bot. Blank
# FORCE_SUB_CHANNEL or FORCE_SUB_ENABLED=false turns this off. The bot
# must be an admin of the channel to check membership.
FORCE_SUB_CHANNEL=TheNexusX
FORCE_SUB_ENABLED=true
FORCE_SUB_CACHE_SECONDS=300

# ── Webhook (optional — omit both to use polling, the simplest setup) ─
WEBHOOK_URL=
WEBHOOK_PORT=8443

# ── Database ────────────────────────────────────────────────────
# Defaults to a local SQLite file — no setup needed. For production,
# point this at Postgres instead:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/novabot
DATABASE_URL=sqlite+aiosqlite:///./data/novabot.db
# REDIS_URL: optional cache layer; leave blank to skip
REDIS_URL=

# ── AI Providers (/ai /chat /code /summarize /imagine) ──────────
# Free-first routing: Gemini → Groq → optional free OpenAI-compat → OpenRouter → paid.
# Provider/model names are NEVER shown to ordinary users (see bot/plugins/ai.py).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openrouter/free
DEFAULT_AI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_HOUR=20
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional OpenAI-compatible free endpoint (Cerebras, Together, local, etc.)
FREE_AI_API_KEY=
FREE_AI_BASE_URL=
FREE_AI_MODEL=

# ── External APIs (all optional — commands degrade gracefully) ──
YOUTUBE_API_KEY=
TMDB_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
GENIUS_API_KEY=
# Optional: /lyrics also returns the lyric text itself when true AND `pip install lyricsgenius` is done.
# Lyrics are copyrighted - the default (false) sends only the title, artist and the official Genius link.
LYRICS_FULLTEXT_ENABLED=false
# Optional: second /wallpaper source (Wallhaven is used first and needs no key)
UNSPLASH_ACCESS_KEY=
# Optional: replace the public screenshot service used by /webss
WEBSS_API_URL=

# ── Live Voice-Chat Music ─────────────────────────────────────
# Joining and streaming into a voice chat needs an MTProto session,
# which the plain Bot API can't provide. Get MUSIC_API_ID and
# MUSIC_API_HASH for free from https://my.telegram.org (API
# Development Tools) — same bot account, just a second login method.
# Leave these blank and /play etc. will explain that live music isn't
# configured; /music and /yt (download + send as a file) keep working
# regardless.
MUSIC_API_ID=
MUSIC_API_HASH=
MUSIC_SESSION_NAME=novabot_music
FFMPEG_PATH=/usr/bin/ffmpeg
MUSIC_WORKERS=8
MUSIC_MAX_CONNECTIONS=100
MAX_QUEUE_SIZE=2000
DEFAULT_GROUP_VOLUME=100
MAX_GROUP_VOLUME=200

# ── Multi-Assistant Scaling (optional) ───────────────────────────
# One assistant can only be in a limited number of voice chats at once.
# Add more BOT accounts here (their own BOT_TOKEN from BotFather, comma-
# separated) to spread load across several — same account type as the
# primary assistant, not a different login method. Leave blank to run
# with just the one.
MUSIC_EXTRA_BOT_TOKENS=
ASSISTANT_AUTO_LEAVE_SECONDS=0

# ── Multi-Platform Music Sources (optional) ──────────────────────
# Spotify/Apple Music/Resso links resolve to searchable metadata, then
# stream the match from YouTube — their own audio is never used. Get
# free Spotify API credentials at developer.spotify.com/dashboard.
# SoundCloud needs no config; yt-dlp streams it directly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Playlists, Video, Cleanmode ──────────────────────────────────
PLAYLIST_FETCH_LIMIT=25
SERVER_PLAYLIST_LIMIT=30
SONG_DOWNLOAD_DURATION_LIMIT=180
VIDEO_STREAM_LIMIT=3
CLEANMODE_DELETE_MINUTES=5

# ── Access Control ────────────────────────────────────────────────
# Startup default for private-bot-mode; the live value is DB-backed and
# toggleable at runtime with /privatemode without restarting.
PRIVATE_BOT_MODE=false

# ── Personality Mode (sarcastic auto-replies) ────────────────────
# On by default in DMs, off by default in groups (admins opt in with
# /personality on in the group itself).
PERSONALITY_COOLDOWN_SECONDS=1.5
PERSONALITY_MAX_CONTEXT=20
PERSONALITY_SARCASM_PROBABILITY=0.85
PERSONALITY_DEFAULT_DM=true
PERSONALITY_DEFAULT_GROUP=false
PERSONALITY_DEFAULT_SKIN=neko
PERSONALITY_LLM_ENABLED=false
PERSONALITY_LLM_TIMEOUT_SECONDS=12
PERSONALITY_FEWSHOT_ENABLED=true
PERSONALITY_FEWSHOT_MAX=3

# Real-person personas (skins "tanvi", "tanvi_iziiee", "tanvi_ichiiren", "yashmeet" / alias
# "galaxy_anhilator"). They imitate the chat style of real people from supplied chat exports.
# false = hide and disable all of them (other skins are unaffected).
PERSON_PERSONAS_ENABLED=true
# Show the "bot imitating <name>" notice when an admin selects one of these skins.
PERSON_PERSONA_DISCLOSURE=true
CONFIG_VERSION=4

# ── Fonts ─────────────────────────────────────────────────────
# The forced "join this channel to use font commands" gate is OFF by
# default. Set FONT_GATE_ENABLED=true and FONT_GATE_CHANNEL=@yourchannel
# to require membership before /f1-/f10 etc. will respond.
FONT_GATE_ENABLED=false
FONT_GATE_CHANNEL=
FONT_RATE_LIMIT_WINDOW=60
FONT_RATE_LIMIT_MAX=20

# ── Anti-Spam Heuristics ─────────────────────────────────────────
ANTIFLOOD_THRESHOLD=5
ANTIFLOOD_INTERVAL=6
ANTIFLOOD_BAN_DURATION=300
SPAM_ML_THRESHOLD=0.75

# ── Feature Toggles — flip any of these to "false" to disable a
# whole subsystem without touching code ─────────────────────────
ENABLE_AI=true
ENABLE_MUSIC_DOWNLOAD=true
ENABLE_LIVE_MUSIC=true
ENABLE_ANIME=true
ENABLE_CAPTCHA=true
ENABLE_FEDERATION=true
ENABLE_PERSONALITY=true
ENABLE_FONTS=true
ENABLE_ECONOMY=true
ENABLE_GAMES=true
ENABLE_SCHEDULING=true
ENABLE_AUTOMOD=true
ENABLE_PLAYLISTS=true
ENABLE_COLLECTOR=true
ENABLE_REACTIONS=true

# ── Economy & Leveling ────────────────────────────────────────
ECONOMY_XP_PER_MESSAGE=5
ECONOMY_XP_COOLDOWN_SECONDS=60
ECONOMY_STARTING_BALANCE=100
ECONOMY_DAILY_MIN=50
ECONOMY_DAILY_MAX=150

# ── Games ─────────────────────────────────────────────────────
GAMES_MIN_BET=10
GAMES_MAX_BET=5000

# ── Character Collector ──────────────────────────────────────────
COLLECTOR_SPAWN_RATE=50
COLLECTOR_TRADE_EXPIRY_MINUTES=5
COLLECTOR_CATCH_REWARD_COINS=20

# ── Auto-Moderation (per-chat overridable via /setwarnlimit etc.) ─
DEFAULT_WARN_LIMIT=3
DEFAULT_WARN_ACTION=mute
# Most messages one /purge may delete (1-10000)
PURGE_MAX_MESSAGES=1000
ANTIRAID_JOIN_THRESHOLD=5
ANTIRAID_JOIN_WINDOW=10

# ── Dashboard ─────────────────────────────────────────────────
# How often (seconds) the bot writes a status snapshot for the separate
# read-only dashboard service to read. See dashboard/main.py.
DASHBOARD_HEARTBEAT_INTERVAL=30
# Password for the dashboard (HTTP Basic: any username, this value as the
# password). Leave blank for no auth — then keep the port on localhost.
DASHBOARD_TOKEN=

# Optional image URL attached to /couples (Couple of The Day). Text-only when blank.
COUPLE_ART_URL=

# ── Additional tunables (defaults live in bot/config.py; uncomment to override) ──
# Language used when a chat has no /lang setting and the user's Telegram language has no catalog (see data/locales/).
# DEFAULT_LANGUAGE=en
# DATA_DIR=./data
# DOWNLOADS_DIR=./data/downloads
# SESSIONS_DIR=./sessions
# OMDB_API_KEY=
# PERSONALITY_JOKE_MIN_INTERVAL=300
# PERSONALITY_JOKE_COOLDOWN_ENABLED=True
# PERSONALITY_USER_LIMIT_DEFAULT=20
# PERSONALITY_USER_LIMIT_MAX=100
# PERSONALITY_MSG_COUNT_RESET_HOURS=24
# PERSONALITY_RESPONSE_DELAY_DEFAULT=3.0
# PERSONALITY_RESPONSE_DELAY_MIN=0.0
# PERSONALITY_CLEANUP_DAYS=30
# Comma-separated limit for /lang (default: every catalog: en hi hl es ru id ar zh fr pt). English is always kept.
# SUPPORTED_LANGUAGES=

# ── Fine-tuned persona adapters (optional; see docs/FINE_TUNING.md) ──
# PERSONA_MODEL_ENABLED=false
# PERSONA_MODEL_BASE_URL=http://localhost:8000/v1
# PERSONA_MODEL_API_KEY=
# PERSONA_MODEL_TIMEOUT_SECONDS=12
# PERSONA_MODEL_TEMPERATURE=0.7
# PERSONA_MODEL_TOP_P=0.9
# PERSONA_ADAPTER_DIR=./data/models/persona_adapters
# PERSONA_MODEL_MARKER=🤖


# ── Persona engine (optional; see docs/PERSONA_ENGINE.md) - free-first, no GPU, no fine-tuning ──
# PERSONA_ENGINE_ENABLED=false
# PERSONA_ENGINE_PROVIDER=auto            # auto | openai_compat | project | none
# PERSONA_ENGINE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / llama.cpp / vLLM, or any OpenAI-compatible free tier
# PERSONA_ENGINE_MODEL=
# PERSONA_ENGINE_API_KEY=
# PERSONA_ENGINE_CANDIDATES=3
# PERSONA_ENGINE_EXAMPLES=4
# PERSONA_ENGINE_TEMPERATURE=0.85
# PERSONA_ENGINE_TIMEOUT_SECONDS=14
# PERSONA_ENGINE_REGENERATE=1
# PERSONA_ENGINE_MEMORY_ENABLED=false
# PERSONA_ENGINE_HUMAN_DELAY=false
# PERSONA_ENGINE_MARKER=🤖


# ── Activity rankings (ChatFight port; see docs/CHATFIGHT.md) ──
# ACTIVITY_ENABLED=true
# ACTIVITY_TIMEZONE=Asia/Kolkata         # decides when "today" / "this week" roll over
# ACTIVITY_FLUSH_INTERVAL=180            # seconds between batched writes of message counts
# ACTIVITY_SPAM_THRESHOLD=10             # msgs within the window that pause counting (0 = off)
# ACTIVITY_SPAM_WINDOW=10
# ACTIVITY_SPAM_BLOCK_SECONDS=1200
# ACTIVITY_COUNT_BOTS=false

# ── Owner self-update (/update, /restart) ──
# UPSTREAM_REPO=                         # git URL used by /update (needs a .git checkout)
# UPSTREAM_BRANCH=main
# GIT_TOKEN=                             # optional token for a private upstream repo

# ── Whispers (PsstRobot port; see docs/WHISPERS.md) ──
# WHISPER_ENABLED=true
# WHISPER_MAX_EXPIRY_DAYS=14             # unread whispers are deleted after this many days
# WHISPER_CLEANUP_MINUTES=15
# WHISPER_HISTORY_SIZE=3                 # recent recipients offered as one-tap choices
# WHISPER_SUPPORT_URL=                   # optional support link shown on the whisper help page
